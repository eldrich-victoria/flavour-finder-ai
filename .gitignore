# -----------------------------
# 🔒 Virtual Environment
# -----------------------------
venv/
.venv/
env/
ENV/

# -----------------------------
# 🧾 Python Cache
# -----------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/

# -----------------------------
# 📁 Data
# -----------------------------
# Ignore large raw dataset files
data/*.csv
data/*.xlsx
data/*.json
data/*.parquet

# -----------------------------
# 🧠 ML Models & Large Artifacts
# -----------------------------
# Ignore large model files and archives
models.zip
models/similarity.pkl

# General ignore for other large model types
*.joblib
*.h5
*.keras
*.pt
*.pth
*.onnx
*.safetensors
*.bin

# NOTE: models/restaurants.pkl is required for the application to run
# and is small enough (3.9 MB) to be tracked. Do NOT ignore *.pkl globally.

# -----------------------------
# 🛠️ Logs & Temp Files
# -----------------------------
*.log
*.tmp
*.swp
*.swo
.cache/

# -----------------------------
# 🧪 Jupyter Notebook
# -----------------------------
.ipynb_checkpoints/

# -----------------------------
# ⚙️ Environment Variables & Secrets
# -----------------------------
.env
.env.*
!.env.example
secrets.json
*.pem
*.key
credentials.*
secrets.*

# -----------------------------
# 🖥️ OS Files
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

# -----------------------------
# 🧑‍💻 IDE / Editor Files
# -----------------------------
.vscode/
.idea/

# -----------------------------
# 🚀 Build / Dist
# -----------------------------
build/
dist/
*.egg-info/

# -----------------------------
# 📝 Other files 
# -----------------------------
project_summary.md
models/
*.zip